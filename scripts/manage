#!/usr/bin/env bash

# =============================================================
# nvimz: Maintenance and Management
#
# Tasks:
#   - Update plugins (native vim.pack)
#   - Sync system packages
#   - Validate the toolchain
# =============================================================

set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

info() { printf "\033[1;34m[INFO]\033[0m %s\n" "$1"; }
ok() { printf "\033[1;32m[OK]\033[0m %s\n" "$1"; }

# =============================================================
# Tasks
# =============================================================

update_plugins() {
  info "Updating Neovim plugins..."
  nvim --headless -c "lua vim.pack.update(nil, { force = true })" -c "qa"
  ok "Plugins updated."

  info "Rebuilding Treesitter parsers..."
  "$ROOT_DIR/scripts/parsers"
  ok "Parsers updated."
}

sync_system() {
  info "Syncing system packages..."
  if command -v brew >/dev/null 2>&1; then
    brew upgrade
  elif [[ -f /etc/arch-release ]]; then
    if command -v yay >/dev/null 2>&1; then yay -Syu
    elif command -v paru >/dev/null 2>&1; then paru -Syu
    else sudo pacman -Syu
    fi
  elif [[ -f /etc/debian_version ]]; then
    sudo apt update && sudo apt upgrade -y
  fi
  ok "System packages synced."
}

# =============================================================
# Main
# =============================================================

usage() {
  echo "Usage: $0 [task]"
  echo ""
  echo "Tasks:"
  echo "  --update    Update plugins and rebuild Treesitter parsers"
  echo "  --sync      Sync system packages"
  echo "  --all       Run update and sync"
  exit 1
}

if [[ $# -eq 0 ]]; then
  usage
fi

case "$1" in
  --update) update_plugins ;;
  --sync) sync_system ;;
  --all)
    update_plugins
    sync_system
    ;;
  *) usage ;;
esac
