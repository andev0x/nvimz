#!/usr/bin/env bash

# =============================================================
# nvimz: Shell health check
#
# Mirrors the lists in:
#   lua/nvimz/config/tools.lua
#   lua/nvimz/config/languages.lua
#   lua/nvimz/config/parsers.lua
# Run :checkhealth nvimz inside Neovim for the authoritative report.
# =============================================================

set -euo pipefail

CORE=(git rg fd)

LSP=(
  gopls
  pyright-langserver
  typescript-language-server
  jdtls
  rust-analyzer
  lua-language-server
  terraform-ls
  yaml-language-server
  vscode-json-language-server
  marksman
)

FORMATTERS=(stylua black shfmt gofmt terraform google-java-format)

PARSERS=(
  c cpp go rust python typescript tsx lua vim vimdoc
  gitcommit git_rebase diff markdown markdown_inline json
)

PARSER_DIR="${HOME}/.local/share/nvim/site/parser"

ok() { printf "\033[1;32m[OK]\033[0m %-28s\n" "$1"; }
err() { printf "\033[1;31m[MISSING]\033[0m %-28s\n" "$1"; }

echo -e "\n--- Core tools (required) ---"
for tool in "${CORE[@]}"; do
  if command -v "$tool" >/dev/null 2>&1; then ok "$tool"; else err "$tool"; fi
done

echo -e "\n--- Language servers (optional) ---"
for tool in "${LSP[@]}"; do
  if command -v "$tool" >/dev/null 2>&1; then ok "$tool"; else err "$tool"; fi
done

echo -e "\n--- Formatters (optional) ---"
for tool in "${FORMATTERS[@]}"; do
  if command -v "$tool" >/dev/null 2>&1; then ok "$tool"; else err "$tool"; fi
done

echo -e "\n--- Treesitter parsers ---"
for parser in "${PARSERS[@]}"; do
  if [ -f "$PARSER_DIR/$parser.so" ]; then ok "$parser"; else err "$parser"; fi
done

echo ""
